# Android.mk for Sandvik
# Auto-generated by CMake

LOCAL_PATH := $(call my-dir)

# 主库
include $(CLEAR_VARS)
LOCAL_MODULE := sandvik
LOCAL_SRC_FILES := lib/libsandvik.so
LOCAL_EXPORT_C_INCLUDES := $(LOCAL_PATH)/include
include $(PREBUILT_SHARED_LIBRARY)

# JNI包装库（如果启用）
@SANDVIK_ENABLE_JNI@
ifeq ($(SANDVIK_ENABLE_JNI),1)
include $(CLEAR_VARS)
LOCAL_MODULE := sandvik_jni
LOCAL_SRC_FILES := lib/libsandvik_jni.so
LOCAL_SHARED_LIBRARIES := sandvik
include $(PREBUILT_SHARED_LIBRARY)
endif

# 可执行文件（如果启用）
@SANDVIK_BUILD_EXECUTABLE@
ifeq ($(SANDVIK_BUILD_EXECUTABLE),1)
include $(CLEAR_VARS)
LOCAL_MODULE := sandvik_vm
LOCAL_SRC_FILES := bin/sandvik
include $(PREBUILT_EXECUTABLE)
endif

# 包含目录
SANDVIK_INCLUDES := $(LOCAL_PATH)/include

# 使用示例
# 在您的Android.mk中添加：
# LOCAL_SHARED_LIBRARIES += sandvik
# LOCAL_C_INCLUDES += $(SANDVIK_INCLUDES)